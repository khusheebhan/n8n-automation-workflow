            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You generate viral Zack D Films style short video ideas.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate ONE viral educational short video idea. Output only the idea sentence.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "510db21c-edae-490c-b187-b849f22cd01d",
      "name": "Idea"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "ADD_YOUR_API",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "ADD_YOUR_API_KEY_VALUE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert educational video script writer for cinematic short videos similar to Zack D Films.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Create a short educational video script about {{ $node[\\\"Idea\\\"].json[\\\"idea\\\"] }}. The output must be valid JSON only. Do NOT include explanations. Structure it as an array of scenes with the following format: [{\\\"scene\\\":1,\\\"visual\\\":\\\"what we see on screen\\\",\\\"narration\\\":\\\"voiceover line\\\",\\\"duration\\\":4}]. Create exactly 4 scenes. Visuals should be cinematic, dramatic, and educational. Narration must be short, punchy, and easy to understand.\"\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        432,
        0
      ],
      "id": "2eabaa00-24e6-4bcd-97d4-178c8409ec36",
      "name": "Generate Script"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "ADD_YOUR_API",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "ADD_YOUR_API_KEY_VALUE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You extract scene information from a JSON script.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Return only the scenes JSON from this script: {{ $node[\\\"Generate Script\\\"].json[\\\"choices\\\"][0][\\\"message\\\"][\\\"content\\\"] }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        656,
        0
      ],
      "id": "ff73ac77-b29c-48ce-9cf8-f702324aad2b",
      "name": "Split Scenes"
    },
    {
