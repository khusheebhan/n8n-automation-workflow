              "value": "ADD_YOUR_API_KEY_VALUE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You create short cinematic prompts for image generation.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Convert this scene into a short Stable Diffusion style prompt with a clear subject first: {{ $node[\\\"Split Scenes\\\"].json[\\\"visual\\\"] }}. Format: subject, environment, ultra realistic 3D render, octane render, cinematic lighting, volumetric lighting, depth of field, educational illustration.\"\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        864,
        0
      ],
      "id": "adb82a12-8e34-4251-ab7e-8775e1424b62",
